<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esperanza.controller.DashboardBodegaController"
            stylesheets="@style/dashboard.css"
            styleClass="root-dashboard">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="header-bar header-bodega">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="Librería La Esperanza"
                   styleClass="header-title"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblBienvenida"
                   styleClass="header-user"/>

            <Button fx:id="btnCerrarSesion"
                    text="Cerrar aplicación"
                    onAction="#onCerrarSesion"
                    styleClass="btn-logout"/>

        </HBox>
    </top>

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="content-area">

            <padding>
                <Insets top="20"
                        right="40"
                        bottom="20"
                        left="40"/>
            </padding>

            <Label text="Dashboard Bodega"
                   styleClass="dash-title"/>

            <Label fx:id="lblRol"
                   styleClass="dash-subtitle"/>

            <Label fx:id="lblPermisos"
                   styleClass="dash-permisos"
                   wrapText="true"/>

            <!-- Tarjeta principal de stock crítico -->
            <VBox fx:id="cardStockCritico"
                  alignment="CENTER"
                  spacing="5"
                  maxWidth="250"
                  onMouseClicked="#onVerLibrosCriticos"
                  style="-fx-background-color: #ffffff;
                         -fx-padding: 15;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);
                         -fx-cursor: hand;">

                <Label text="Libros en Stock Crítico"
                       style="-fx-text-fill: #64748b;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblCantidadStockCritico"
                       text="0"
                       style="-fx-font-size: 28px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #10B981;"/>

            </VBox>

            <!-- Botones principales -->
            <HBox alignment="CENTER"
                  spacing="20">

                <Button text="Gestión de Inventario"
                        onAction="#onInventario"
                        styleClass="btn-accion"
                        prefWidth="220"
                        prefHeight="50"/>

                <Button text="Registrar ingreso"
                        onAction="#onIngresoInventario"
                        styleClass="btn-accion"
                        prefWidth="200"
                        prefHeight="50"/>

                <Button text="Registrar salida"
                        onAction="#onEntradasSalidas"
                        styleClass="btn-accion"
                        prefWidth="200"
                        prefHeight="50"/>

            </HBox>

            <!-- US-3.5: listado de stock crítico -->
            <VBox spacing="10"
                  maxWidth="760"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-padding: 15;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(
                             three-pass-box,
                             rgba(0,0,0,0.08),
                             8,
                             0,
                             0,
                             2
                         );">

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="Alertas de Stock Crítico:"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="lblContadorCritico"
                           text="0"
                           style="-fx-font-size: 16px;
                                  -fx-text-fill: #e74c3c;
                                  -fx-font-weight: bold;"/>

                </HBox>

                <TableView fx:id="tablaStockCritico"
                           prefHeight="220"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colIsbn"
                                     text="ISBN"
                                     prefWidth="160"/>

                        <TableColumn fx:id="colTitulo"
                                     text="Título"
                                     prefWidth="400"/>

                        <TableColumn fx:id="colStock"
                                     text="Stock Actual"
                                     prefWidth="130"/>

                    </columns>

                    <placeholder>
                        <Label text="No hay libros con stock crítico."/>
                    </placeholder>

                </TableView>

                <HBox alignment="CENTER_RIGHT">

                    <Button text="Abrir Ficha de Libro"
                            onAction="#abrirFichaLibro"
                            styleClass="btn-accion"
                            prefWidth="180"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>