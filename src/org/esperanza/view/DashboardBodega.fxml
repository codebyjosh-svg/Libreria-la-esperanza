<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esperanza.Controller.DashboardBodegaController" stylesheets="@style/dashboard.css" styleClass="root-dashboard">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar header-bodega">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Librería La Esperanza" styleClass="header-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblBienvenida" styleClass="header-user"/>
            <Button fx:id="btnCerrarSesion" text="Cerrar aplicación" onAction="#onCerrarSesion" styleClass="btn-logout"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>
            <Label text="Dashboard Bodega" styleClass="dash-title"/>
            
            <Label fx:id="lblRol" styleClass="dash-subtitle"/>
            <Label fx:id="lblPermisos" styleClass="dash-permisos" wrapText="true"/>
            
            <HBox alignment="CENTER" spacing="20">
                <Button text="Gestión de Inventario" onAction="#onInventario" styleClass="btn-accion" prefWidth="220" prefHeight="50"/>
                <Button text="Entradas / Salidas" onAction="#onEntradasSalidas" styleClass="btn-accion" prefWidth="200" prefHeight="50"/>
            </HBox>
            
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Alertas de Stock Crítico:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblContadorCritico" text="0" style="-fx-font-size: 16px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                </HBox>
                
                <TableView fx:id="tablaStockCritico" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIsbn" prefWidth="120" text="ISBN" />
                        <TableColumn fx:id="colTitulo" prefWidth="350" text="Título" />
                        <TableColumn fx:id="colStock" prefWidth="100" text="Stock Actual" />
                    </columns>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnAbrirFicha" text="Abrir Ficha de Libro" onAction="#abrirFichaLibro" styleClass="btn-accion"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>