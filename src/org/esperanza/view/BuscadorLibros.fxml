<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="750.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esperanza.Controller.BuscadorLibrosController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Buscador de Libros (US-2.1)">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <ComboBox fx:id="cmbFiltro" prefWidth="150.0" promptText="Buscar por..." />
            <TextField fx:id="txtBusqueda" onAction="#buscarLibro" promptText="Ingrese el término de búsqueda..." HBox.hgrow="ALWAYS" />
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarLibro" prefWidth="100.0" text="Buscar" />
         </children>
      </HBox>
      
      <TableView fx:id="tblLibros" prefHeight="400.0" prefWidth="710.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colIsbn" prefWidth="150.0" text="ISBN" />
          <TableColumn fx:id="colTitulo" prefWidth="310.0" text="Título" />
          <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio" />
          <TableColumn fx:id="colStock" prefWidth="110.0" text="Stock" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>