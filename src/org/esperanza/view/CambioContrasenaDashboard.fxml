<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="main-container" stylesheets="@cambiocontrasenadashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esperanza.Controller.CambioContrasenaController">
    <VBox alignment="CENTER" maxWidth="360.0" maxHeight="460.0" spacing="15.0" styleClass="card-container">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>
        
        <StackPane styleClass="icon-background" maxWidth="70.0" maxHeight="70.0" minHeight="70.0" minWidth="70.0">
            <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="white" scaleX="2.0" scaleY="2.0" />
        </StackPane>

        <Label styleClass="title-label" text="Cambiar Contraseña">
            <VBox.margin>
                <Insets bottom="5.0" />
            </VBox.margin>
        </Label>

        <PasswordField fx:id="txtContrasenaActual" promptText="Contraseña actual" styleClass="input-field" />
        <PasswordField fx:id="txtNuevaContrasena" promptText="Nueva contraseña" styleClass="input-field" />
        <PasswordField fx:id="txtConfirmarContrasena" promptText="Confirmar contraseña" styleClass="input-field" />

        <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardar" styleClass="primary-button" text="Guardar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" styleClass="cancel-button" text="Cancelar" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>
</StackPane>