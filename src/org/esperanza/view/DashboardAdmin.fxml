<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.esperanza.Controller.DashboardAdminController"
        stylesheets="@style/dashboard.css"
        styleClass="root-dashboard">

    <top>

        <VBox
                styleClass="header-bar"
                spacing="10">

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="18">

                <padding>

                    <Insets
                            top="15"
                            right="20"
                            bottom="8"
                            left="20"/>

                </padding>

                <Label
                        text="Librería La Esperanza"
                        styleClass="header-title"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Label
                        fx:id="lblBienvenida"
                        styleClass="header-user"/>

                <Button
                        fx:id="btnCerrarSesion"
                        text="Cerrar aplicación"
                        onAction="#onCerrarSesion"
                        styleClass="btn-logout"/>

            </HBox>

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="18">

                <padding>

                    <Insets
                            right="20"
                            bottom="12"
                            left="20"/>

                </padding>

                <Label
                        fx:id="lblRol"
                        styleClass="header-user"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <VBox
                alignment="CENTER"
                spacing="25"
                styleClass="content-area">

            <padding>

                <Insets
                        top="40"
                        right="40"
                        bottom="40"
                        left="40"/>

            </padding>

            <Label
                    text="Dashboard Administrador"
                    styleClass="dash-title"/>

            <Label
                    fx:id="lblPermisos"
                    styleClass="dash-permisos"
                    wrapText="true"/>

            <Label
                    text="Funciones disponibles para el rol Administrador."
                    styleClass="dash-info"
                    wrapText="true"/>

            <HBox
                    alignment="CENTER"
                    spacing="20">

                <Button
                        text="Gestión de Usuarios"
                        onAction="#onGestionUsuarios"
                        styleClass="btn-accion"
                        prefWidth="220"
                        prefHeight="55"/>

                <Button
                        text="Reportes"
                        onAction="#onReportes"
                        styleClass="btn-accion"
                        prefWidth="180"
                        prefHeight="55"/>

                <Button
                        text="Configuración"
                        onAction="#onConfiguracion"
                        styleClass="btn-accion"
                        prefWidth="180"
                        prefHeight="55"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>