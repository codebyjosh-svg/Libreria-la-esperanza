<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esperanza.controller.DashboardAdminController">

    <left>

        <ScrollPane fitToWidth="true" prefWidth="200">

            <VBox spacing="8">

                <padding>
                    <Insets bottom="15" left="10" right="10" top="15" />
                </padding>

                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Librería La Esperanza" />

                <Separator />

                <Button maxWidth="Infinity" onAction="#onUsuariosClick" text="Usuarios" />

                <Button maxWidth="Infinity" onAction="#onCambiarContrasenaClick" text="Cambiar contraseña" />

                <Button maxWidth="Infinity" onAction="#onLibrosClick" text="Libros" />

                <Button maxWidth="Infinity" onAction="#onAutoresClick" text="Autores" />

                <Button maxWidth="Infinity" onAction="#onCategoriasClick" text="Categorías" />

                <Button maxWidth="Infinity" onAction="#onEditorialesClick" text="Editoriales" />

                <Button maxWidth="Infinity" onAction="#onVentasClick" text="Ventas" />

                <Button maxWidth="Infinity" onAction="#onAutoresLibroClick" text="Autores-Libro" />

                <Button maxWidth="Infinity" onAction="#onDetalleVentasClick" text="Detalle Ventas" />

                <Button maxWidth="Infinity" onAction="#onDetalleVentasClick" text="Ventas del Día" />

            </VBox>

        </ScrollPane>

    </left>

    <top>

        <HBox alignment="CENTER_LEFT" spacing="10">

            <padding>
                <Insets bottom="10" left="15" right="15" top="10" />
            </padding>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Panel de Control" />

            <HBox HBox.hgrow="ALWAYS" />

            <Label fx:id="lblUsuario" text="Admin" />

            <Button onAction="#onCerrarSesionClick" text="Cerrar Sesión" />

        </HBox>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Bienvenido" />

            <Label text="Accesos rápidos a las funciones principales del sistema" />

            <HBox spacing="10">

                <Button onAction="#onNuevoLibroClick" prefHeight="60" prefWidth="150" text="Nuevo Libro" />

                <Button onAction="#onVentasClick" prefHeight="60" prefWidth="150" text="Agregar Venta" />

                <Button onAction="#onUsuariosClick" prefHeight="60" prefWidth="150" text="Gestionar Usuarios" />

                <Button onAction="#onClientesClick" prefHeight="60" prefWidth="150" text="Reportes" />

            </HBox>

            <HBox spacing="10">

                <Button onAction="#onCambiarContrasenaClick" prefHeight="60" prefWidth="150" text="Cambiar contraseña" />

            </HBox>

        </VBox>

    </center>

</BorderPane>
