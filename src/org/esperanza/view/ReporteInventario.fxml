<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.11"
            xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="org.esperanza.Controller.ReporteInventarioController"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style/dashboard.css"
            styleClass="root-dashboard">

    <top>

        <VBox spacing="8"
              styleClass="topbar">

            <Label text="Reportes de Inventario"
                   styleClass="topbar-title"/>

            <Label text="Consulta los libros más vendidos y el valor actual del inventario."
                   styleClass="page-subtitle"/>

        </VBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true">

            <content>

                <VBox spacing="18"
                      styleClass="content-area">

                    <padding>
                        <Insets top="20"
                                right="25"
                                bottom="25"
                                left="25"/>
                    </padding>

                    <VBox spacing="10"
                          styleClass="section-card">

                        <Label text="Filtros del reporte"
                               styleClass="section-title"/>

                        <HBox spacing="10"
                              alignment="CENTER_LEFT">

                            <Label text="Desde:"/>

                            <DatePicker fx:id="dpFechaInicio"
                                        prefWidth="150"/>

                            <Label text="Hasta:"/>

                            <DatePicker fx:id="dpFechaFin"
                                        prefWidth="150"/>

                            <Button fx:id="btnFiltrar"
                                    text="Filtrar"
                                    onAction="#onFiltrarClick" 
                                    styleClass="primary-button"/>

                            <Button fx:id="btnLimpiar"
                                    text="Limpiar"
                                    onAction="#onLimpiarClick" />

                        </HBox>

                    </VBox>

                    <VBox spacing="10"
                          styleClass="section-card">

                        <Label text="Libros más vendidos"
                               styleClass="section-title"/>

                        <Label text="Ranking de libros según la cantidad de unidades vendidas."
                               styleClass="page-subtitle"/>

                        <TableView fx:id="tablaLibrosMasVendidos"
                                   prefHeight="220">

                            <columns>

                                <TableColumn fx:id="colRankingIsbn"
                                             text="ISBN"
                                             prefWidth="160"/>

                                <TableColumn fx:id="colRankingTitulo"
                                             text="Título"
                                             prefWidth="390"/>

                                <TableColumn fx:id="colCantidadVendida"
                                             text="Cantidad vendida"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colTotalVendido"
                                             text="Total vendido"
                                             prefWidth="150"/>

                            </columns>

                            <placeholder>
                                <Label text="No hay ventas para mostrar."/>
                            </placeholder>

                        </TableView>

                    </VBox>

                    <!-- Stock valorizado -->

                    <VBox spacing="10"
                          styleClass="section-card">

                        <HBox spacing="15"
                              alignment="CENTER_LEFT">

                            <Label text="Valoración del inventario"
                                   styleClass="section-title"/>

                            <Label fx:id="lblValorTotalInventario"
                                   text="Valor total: Q0.00"
                                   styleClass="role-label"/>

                        </HBox>

                        <Label text="Valor de las existencias actuales de cada libro."
                               styleClass="page-subtitle"/>

                        <TableView fx:id="tablaStockValorizado"
                                   prefHeight="230">

                            <columns>

                                <TableColumn fx:id="colStockIsbn"
                                             text="ISBN"
                                             prefWidth="150"/>

                                <TableColumn fx:id="colStockTitulo"
                                             text="Título"
                                             prefWidth="300"/>

                                <TableColumn fx:id="colStockActual"
                                             text="Stock"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colValorInventario"
                                             text="Valor inventario"
                                             prefWidth="160"/>

                            </columns>

                            <placeholder>
                                <Label text="No hay inventario para mostrar."/>
                            </placeholder>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>