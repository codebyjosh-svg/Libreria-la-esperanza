<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esperanza.Controller.ConfirmarVentaController"
            prefWidth="900"
            prefHeight="700">

    <top>
        <VBox spacing="10">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>


            <HBox alignment="CENTER_LEFT">

                <Label text="Confirmar venta"
                       style="-fx-font-size:24px;
                          -fx-font-weight:bold;"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button text="Volver"
                        onAction="#regresar"/>

            </HBox>


            <Label text="Seleccionar Cliente:"
                   style="-fx-font-weight:bold;"/>


            <TextField fx:id="txtBuscarCliente"
                       promptText="Buscar por CUI, nombre o apellido..."/>



            <TableView fx:id="tablaClientes"
                       prefHeight="120"
                       maxHeight="120">

                <columns>

                    <TableColumn fx:id="colCui"
                                 text="CUI"
                                 prefWidth="200"/>


                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="250"/>


                    <TableColumn fx:id="colApellido"
                                 text="Apellido"
                                 prefWidth="250"/>

                </columns>

            </TableView>



            <Label fx:id="lblCliente"
                   text="Cliente seleccionado: Ninguno"
                   style="-fx-font-weight:bold;"/>


            <Label text="Detalle de productos en la venta:"
                   style="-fx-font-weight:bold;"/>


        </VBox>

    </top>

    <center>

        <VBox>

            <padding>
                <Insets top="0"
                        right="20"
                        bottom="0"
                        left="20"/>
            </padding>


            <TableView fx:id="tablaDetalle"
                       prefHeight="250"
                       maxHeight="250">


                <columns>


                    <TableColumn fx:id="colIsbn"
                                 text="ISBN"
                                 prefWidth="250"/>


                    <TableColumn fx:id="colCantidad"
                                 text="Cantidad"
                                 prefWidth="120"/>


                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="150"/>


                    <TableColumn fx:id="colSubtotal"
                                 text="Subtotal"
                                 prefWidth="150"/>


                </columns>


            </TableView>


        </VBox>


    </center>

    <bottom>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: Q0.00"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <HBox spacing="15">
                <Button text="Finalizar venta"
                        onAction="#finalizarVenta"
                        style="-fx-font-size: 14px; -fx-base: #4CAF50; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>