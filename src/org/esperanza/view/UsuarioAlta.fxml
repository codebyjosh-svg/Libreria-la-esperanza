<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.esperanza.Controller.UsuarioAltaController"
      stylesheets="@style/usuarios.css" styleClass="fondo" spacing="14">
    <padding><Insets top="25" right="35" bottom="25" left="35"/></padding>
    <Label text="Alta de usuario" styleClass="titulo"/>
    <Label text="Completa los datos del nuevo usuario" styleClass="subtitulo"/>
    <GridPane hgap="12" vgap="10">
        <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtUsername" promptText="Ej. jperez" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Confirmar:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtConfirmar" promptText="Repite la contraseña" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Rol:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbRol" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Nombre:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Apellido:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtApellido" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Correo:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-secundario"/>
        <Button text="Guardar usuario" onAction="#onGuardar" styleClass="btn-principal"/>
    </HBox>
</VBox>
