<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900"
            prefHeight="600"
            stylesheets="@style/dashboard.css"
            styleClass="root-dashboard">

    <top>

        <VBox spacing="8"
              styleClass="topbar">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="Actualización de Precio"
                   styleClass="topbar-title"/>

            <Label text="Selecciona un libro y registra su nuevo precio."
                   styleClass="page-subtitle"/>

        </VBox>

    </top>

    <center>

        <HBox spacing="20">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- Lista de libros -->

            <VBox spacing="10"
                  prefWidth="540"
                  styleClass="section-card">

                <Label text="Libros"
                       styleClass="section-title"/>

                <TextField fx:id="txtBuscarLibro"
                           promptText="Buscar por ISBN o título"/>

                <TableView fx:id="tablaLibros"
                           prefHeight="430">

                    <columns>

                        <TableColumn fx:id="colIsbn"
                                     text="ISBN"
                                     prefWidth="140"/>

                        <TableColumn fx:id="colTitulo"
                                     text="Título"
                                     prefWidth="250"/>

                        <TableColumn fx:id="colPrecioActual"
                                     text="Precio actual"
                                     prefWidth="120"/>

                    </columns>

                    <placeholder>
                        <Label text="No hay libros para mostrar."/>
                    </placeholder>

                </TableView>

            </VBox>

            <!-- Formulario de actualización -->

            <VBox spacing="12"
                  prefWidth="280"
                  styleClass="section-card">

                <Label text="Modificar precio"
                       styleClass="section-title"/>

                <Label text="ISBN"/>

                <TextField fx:id="txtIsbn"
                           editable="false"
                           promptText="Selecciona un libro"/>

                <Label text="Título"/>

                <TextField fx:id="txtTitulo"
                           editable="false"
                           promptText="Título del libro"/>

                <Label text="Precio actual"/>

                <TextField fx:id="txtPrecioActual"
                           editable="false"
                           promptText="Q0.00"/>

                <Label text="Nuevo precio"/>

                <TextField fx:id="txtNuevoPrecio"
                           promptText="Ejemplo: 150.00"/>

                <Label text="El nuevo precio debe ser mayor que Q0.00."
                       wrapText="true"
                       styleClass="page-subtitle"/>

                <HBox spacing="10">

                    <Button fx:id="btnActualizar"
                            text="Actualizar Precio"
                            styleClass="primary-button"/>

                    <Button fx:id="btnLimpiar"
                            text="Limpiar"/>

                </HBox>

                <Button fx:id="btnVolver"
                        text="Volver"
                        maxWidth="Infinity"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>