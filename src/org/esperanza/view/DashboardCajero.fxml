<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.esperanza.controller.DashboardCajeroController"
        prefWidth="950"
        prefHeight="620"
        stylesheets="@style/dashboard.css"
        styleClass="root-dashboard">

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="12"
                styleClass="topbar">

            <padding>
                <Insets
                        top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <Label
                    text="Panel de Cajero"
                    styleClass="topbar-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label
                    fx:id="lblBienvenida"
                    styleClass="topbar-user"/>

            <Button
                    text="Cerrar sesión"
                    onAction="#onCerrarSesion"
                    styleClass="logout-button"/>

        </HBox>
    </top>

    <left>
        <ScrollPane
                fitToWidth="true"
                prefWidth="200"
                styleClass="sidebar-scroll">

            <VBox
                    spacing="10"
                    styleClass="sidebar">

                <Label
                        text="Librería La Esperanza"
                        wrapText="true"
                        styleClass="sidebar-brand"/>

                <Label
                        fx:id="lblRol"
                        styleClass="sidebar-role"/>

                <Label
                        fx:id="lblPermisos"
                        wrapText="true"
                        styleClass="role-label"/>

                <Separator/>

                <Button
                        text="Nueva venta"
                        onAction="#onNuevaVenta"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"/>

                <Button
                        text="Devoluciones"
                        onAction="#onDevoluciones"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"/>

                <Button
                        text="Clientes"
                        onAction="#onClientes"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"/>

                <Button
                        text="Consultar stock"
                        onAction="#onConsultarProductos"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"/>

                <Button
                        text="Mis ventas y facturas"
                        onAction="#onMisVentas"
                        maxWidth="Infinity"
                        wrapText="true"
                        styleClass="sidebar-button"/>

                <Button
                        text="Editar clientes"
                        onAction="#onEditarClientes"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"/>

            </VBox>

        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true">

            <VBox
                    spacing="20"
                    styleClass="content-area">

                <padding>
                    <Insets
                            top="25"
                            right="20"
                            bottom="20"
                            left="20"/>
                </padding>

                <Label
                        text="Bienvenido"
                        styleClass="page-title"/>

                <Label
                        text="Accesos rápidos a las funciones de caja"
                        styleClass="page-subtitle"/>

                <FlowPane
                        hgap="15"
                        vgap="15">

                    <Button
                            text="Nueva venta"
                            onAction="#onNuevaVenta"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                    <Button
                            text="Devoluciones"
                            onAction="#onDevoluciones"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                    <Button
                            text="Clientes"
                            onAction="#onClientes"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                    <Button
                            text="Consultar stock"
                            onAction="#onConsultarProductos"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                    <Button
                            text="Mis ventas y facturas"
                            onAction="#onMisVentas"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                    <Button
                            text="Editar clientes"
                            onAction="#onEditarClientes"
                            prefWidth="185"
                            prefHeight="60"
                            wrapText="true"
                            styleClass="quick-button"/>

                </FlowPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>