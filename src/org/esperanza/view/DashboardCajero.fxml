<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.esperanza.controller.DashboardCajeroController"
        prefWidth="950"
        prefHeight="620"
        stylesheets="@style/dashboard.css">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label
                    text="Panel de Control"
                    style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblBienvenida"/>

            <Button
                    text="Cerrar Sesión"
                    onAction="#onCerrarSesion"/>

        </HBox>
    </top>

    <left>
        <VBox prefWidth="200" spacing="10">

            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Label
                    text="Librería La Esperanza"
                    style="-fx-font-weight:bold;"/>

            <Label fx:id="lblRol"/>

            <Label
                    fx:id="lblPermisos"
                    visible="false"
                    managed="false"/>

            <Separator/>

            <Button
                    text="Nueva venta"
                    onAction="#onNuevaVenta"
                    maxWidth="Infinity"/>

            <Button
                    text="Clientes"
                    onAction="#onClientes"
                    maxWidth="Infinity"/>

            <Button
                    text="Consultar stock"
                    onAction="#onConsultarProductos"
                    maxWidth="Infinity"/>

            <Button
                    text="Mis ventas y facturas"
                    onAction="#onMisVentas"
                    maxWidth="Infinity"/>

            <Button
                    text="Editar clientes"
                    onAction="#onEditarClientes"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="25" right="20" bottom="20" left="20"/>
            </padding>

            <Label
                    text="Bienvenido"
                    style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <Label text="Accesos rápidos a las funciones de caja"/>

            <FlowPane hgap="15" vgap="15">

                <Button
                        text="Nueva venta"
                        onAction="#onNuevaVenta"
                        prefWidth="180"
                        prefHeight="65"/>

                <Button
                        text="Clientes"
                        onAction="#onClientes"
                        prefWidth="180"
                        prefHeight="65"/>

                <Button
                        text="Consultar stock"
                        onAction="#onConsultarProductos"
                        prefWidth="180"
                        prefHeight="65"/>

                <Button
                        text="Mis ventas y facturas"
                        onAction="#onMisVentas"
                        prefWidth="180"
                        prefHeight="65"/>

                <Button
                        text="Editar clientes"
                        onAction="#onEditarClientes"
                        prefWidth="180"
                        prefHeight="65"/>

            </FlowPane>

        </VBox>
    </center>

</BorderPane>