<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680.0"
            prefWidth="920.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esperanza.Controller.CarritoVentaController">

    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <top>

    <HBox alignment="CENTER_LEFT"
          spacing="20">

        <VBox spacing="5">

            <Label text="Carrito de venta · Librería La Esperanza"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Seleccione el cliente y los libros que desea agregar a la venta."/>

        </VBox>


        <HBox HBox.hgrow="ALWAYS"/>


        <Button text="Volver"
                onAction="#volver"/>


    </HBox>

</top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER">
            <content>
                <VBox spacing="12">

                    <padding>
                        <Insets top="15" right="5" bottom="15" left="5"/>
                    </padding>

                    <Separator/>

                    <Label text="Libros disponibles"
                           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <Label text="Buscar libro:"/>

                        <TextField fx:id="txtBuscar"
                                   promptText="Buscar por ISBN, título o autor"
                                   prefWidth="400"/>

                    </HBox>

                    <TableView fx:id="tblDisponibles"
                               prefHeight="140">

                        <columns>
                            <TableColumn fx:id="colDisponibleIsbn"
                                         text="ISBN"
                                         prefWidth="190"/>

                            <TableColumn fx:id="colDisponibleTitulo"
                                         text="Título"
                                         prefWidth="330"/>

                            <TableColumn fx:id="colDisponiblePrecio"
                                         text="Precio"
                                         prefWidth="130"/>

                            <TableColumn fx:id="colDisponibleStock"
                                         text="Stock disponible"
                                         prefWidth="150"/>
                        </columns>

                    </TableView>

                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <VBox spacing="5">
                            <Label text="Cantidad"/>
                            <TextField fx:id="txtCantidad"
                                       text="1"
                                       prefWidth="100"/>
                        </VBox>

                        <VBox alignment="BOTTOM_LEFT">
                            <Button fx:id="btnAgregar"
                                    text="Agregar al carrito"
                                    onAction="#agregarLibro"
                                    prefWidth="150"/>
                        </VBox>

                    </HBox>

                    <Separator/>

                    <Label text="Productos en el carrito"
                           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

                    <TableView fx:id="tabla"
                               prefHeight="140">

                        <columns>
                            <TableColumn fx:id="colIsbn"
                                         text="ISBN"
                                         prefWidth="220"/>

                            <TableColumn fx:id="colCantidad"
                                         text="Cantidad"
                                         prefWidth="120"/>

                            <TableColumn fx:id="colPrecio"
                                         text="Precio unitario"
                                         prefWidth="170"/>

                            <TableColumn fx:id="colSubtotal"
                                         text="Subtotal"
                                         prefWidth="170"/>
                        </columns>

                    </TableView>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10">

            <HBox spacing="10">

                <VBox spacing="5">
                    <Label text="Nueva cantidad"/>
                    <TextField fx:id="txtNuevaCantidad"
                               text="1"
                               prefWidth="100"/>
                </VBox>

                <VBox alignment="BOTTOM_LEFT">
                    <Button fx:id="btnActualizar"
                            text="Actualizar cantidad"
                            onAction="#actualizarCantidad"/>
                </VBox>

                <VBox alignment="BOTTOM_LEFT">
                    <Button fx:id="btnEliminar"
                            text="Eliminar libro"
                            onAction="#eliminarLibro"/>
                </VBox>

                <VBox alignment="BOTTOM_LEFT">
                    <Button fx:id="btnVaciar"
                            text="Vaciar carrito"
                            onAction="#vaciarCarrito"/>
                </VBox>

                <VBox alignment="BOTTOM_LEFT">
                    <Button fx:id="btnConfirmar"
                            text="Confirmar venta"
                            onAction="#confirmarVenta"/>
                </VBox>

            </HBox>

            <Separator/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Tipo de descuento"/>
                    <ComboBox fx:id="cmbTipoDescuento" prefWidth="190"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Valor del descuento"/>
                    <TextField fx:id="txtValorDescuento"
                               promptText="Ej. 10 o 12.50"
                               prefWidth="160"/>
                </VBox>
                <Label fx:id="lblAvisoDescuento" wrapText="true"/>
            </HBox>

            <HBox spacing="20">
                <Label fx:id="lblSubtotalVenta" text="Subtotal: Q0.00"/>
                <Label fx:id="lblDescuentoVenta" text="Descuento: -Q0.00"/>
            </HBox>

            <Label fx:id="lblTotal"
                   text="Total: Q0.00"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label fx:id="lblMensaje"
                   wrapText="true"/>

        </VBox>
    </bottom>

</BorderPane>