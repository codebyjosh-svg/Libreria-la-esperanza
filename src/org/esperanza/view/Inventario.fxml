<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esperanza.Controller.InventarioController"
            stylesheets="@style/inventario.css"
            styleClass="inventario-root"
            prefWidth="900"
            prefHeight="560">

    <left>

        <VBox spacing="18"
              prefWidth="220"
              styleClass="panel-lateral">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="30"
                        left="20"/>
            </padding>

            <Label text="Inventario"
                   styleClass="titulo-lateral"/>

            <Label text="Consulta las existencias disponibles de cada libro."
                   wrapText="true"
                   styleClass="texto-lateral"/>

            <Label text="Los libros con stock crítico se muestran resaltados."
                   wrapText="true"
                   styleClass="texto-ayuda"/>

            <Button text="Actualizar"
                    onAction="#onActualizar"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="btn-actualizar"/>

            <Button text="Volver al Dashboard"
                    onAction="#onVolver"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="btn-volver"/>

        </VBox>

    </left>

    <center>

        <VBox spacing="15"
              styleClass="contenido-inventario">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <Label text="Stock de Libros"
                   styleClass="titulo-principal"/>

            <Label text="Consulta y busca las existencias actuales de la librería."
                   styleClass="subtitulo"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por ISBN, título, precio, stock o estado..."
                       prefHeight="42"
                       styleClass="campo-busqueda"/>

            <HBox alignment="CENTER_LEFT">

                <Label fx:id="lblTotal"
                       text="Mostrando 0 libros"
                       styleClass="contador"/>

            </HBox>

            <TableView fx:id="tablaInventario"
                       VBox.vgrow="ALWAYS"
                       styleClass="tabla-inventario">

                <columns>

                    <TableColumn fx:id="colIsbn"
                                 text="ISBN"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colTitulo"
                                 text="Título"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colStockActual"
                                 text="Stock actual"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colStockMinimo"
                                 text="Stock mínimo"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="100"/>

                </columns>

                <placeholder>

                    <Label text="No hay libros para mostrar."/>

                </placeholder>

            </TableView>

        </VBox>

    </center>

</BorderPane>