<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esperanza.controller.LibrosCriticosController"
            style="-fx-background-color: #f8fafc;" prefWidth="650" prefHeight="400">
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #EF4444; -fx-padding: 15;">
            <Label text="⚠️ Listado de Libros con Stock Crítico" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <TableView fx:id="tblLibrosCriticos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="130"/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                    <TableColumn fx:id="colStockActual" text="Stock Actual" prefWidth="110"/>
                    <TableColumn fx:id="colStockMinimo" text="Stock Mínimo" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 15 20;">
            <Button text="Cerrar" fx:id="btnCerrar" onAction="#onCerrar" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>